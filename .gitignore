.dirstamp
*.so
*.dylib
*.exe
*~
*.d
*.o
*.gch
*/*/*/*/idl/*.cxx
*/*/*/*/idl/*.h
*-bin/
target-*/
*.deps
gen/
**/driver/modules.order
/prerequisites
/prerequisites-build

# Temporary, until we rename targets
*.old
*.bak
*.hold
*.orig
*.log
a.out*
\.\#*
\#*\#
.DS_Store
timeData.raw
*.pyc
lib/
run/
!/projects/*/rcc/platforms/xilinx*/opencpi-*-release*/**/lib
!/projects/*/rcc/platforms/xilinx*/opencpi-*-release*/**/*.so
