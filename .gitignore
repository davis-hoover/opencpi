/tests/pytests/project-registry/
/tests/pytests/utilization_proj/

# Projects
/projects/*
!/projects/assets/
!/projects/assets_ts/
!/projects/core/
!/projects/inactive/
!/projects/osps/
!/projects/platform/
!/projects/test/
!/projects/tutorial/
