{
    "rules": [
      {
        "rulePriority": 1,
        "description": "Keep develop images",
        "selection": {
          "tagStatus": "tagged",
          "tagPrefixList": [
            "develop"
          ],
          "countType": "imageCountMoreThan",
          "countNumber": 10
        },
        "action": {
          "type": "expire"
        }
      },
      {
        "rulePriority": 2,
        "description": "Keep release images",
        "selection": {
          "tagStatus": "tagged",
          "tagPrefixList": [
            "v"
          ],
          "countType": "imageCountMoreThan",
          "countNumber": 10
        },
        "action": {
          "type": "expire"
        }
      },
      {
        "rulePriority": 3,
        "description": "Expire non-develop and non-release images older than 7 days",
        "selection": {
          "tagStatus": "any",
          "countType": "sinceImagePushed",
          "countUnit": "days",
          "countNumber": 7
        },
        "action": {
          "type": "expire"
        }
      }
    ]
  }
