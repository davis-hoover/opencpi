     </table:table-cell>
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P83">6 Bits</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.D2" office:value-type="string">
      <text:p text:style-name="P83">2 Bits</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P78"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P78"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P83">Admin Bits</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.D2" office:value-type="string">
      <text:p text:style-name="P78"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A2" office:value-type="string">
      <text:p text:style-name="P78"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A2" table:number-columns-spanned="2" office:value-type="string">
