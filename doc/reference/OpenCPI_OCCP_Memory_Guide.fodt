      <text:p text:style-name="P50"><text:bookmark-start text:name="__DdeLink__1142292_1709782271"/><text:bookmark-end text:name="__DdeLink__1142292_1709782271"/><text:span text:style-name="Internet_20_link"><text:span text:style-name="T9"/></text:span></text:p>
