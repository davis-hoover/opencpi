     <table:table-cell table:style-name="Table24.D2" office:value-type="string">
      <text:p text:style-name="P349"><text:span text:style-name="Code"><text:span text:style-name="T454">to_bool(b : boolean)<text:line-break/>to_bool(b : std_logic)<text:line-break/>its(b : bool_t) return boolean</text:span></text:span></text:p>
     </table:table-cell>
