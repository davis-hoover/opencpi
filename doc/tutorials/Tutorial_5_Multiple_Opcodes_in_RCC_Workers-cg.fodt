   <text:p text:style-name="P7">To buil<text:span text:style-name="T99">d </text:span>the unit test with <text:span text:style-name="Code">ocpidev</text:span><text:span text:style-name="Code"><text:span text:style-name="T39">, </text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T42">run the </text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T44">following </text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T42">command </text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T44">from the </text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T71">components/t</text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T69">ime_demux.test/</text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T44"> directory in </text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T69">DemoProject5</text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T42">:</text:span></text:span></text:p>
   <text:p text:style-name="Code"><text:span text:style-name="Code"><draw:frame text:anchor-type="as-char" draw:z-index="11" draw:name="Shape15" draw:style-name="gr12" draw:text-style-name="P200" svg:width="5.6043in" svg:height="0.2079in">
      <draw:text-box>
       <text:p><text:span text:style-name="T214">ocpidev build test --rcc-platform centos7</text:span></text:p>
      </draw:text-box>
     </draw:frame></text:span></text:p>
   <text:h text:style-name="P91" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2357_3952663903"/>Run Unit Test<text:bookmark-end text:name="__RefHeading___Toc2357_3952663903"/></text:h>
   <text:p text:style-name="P49">Now we’ll run the unit test for the time demux worker.</text:p>
   <text:section text:style-name="Sect2" text:name="Section5" text:condition="ooow:AVGUI LEQ 1" text:display="condition">
    <text:p text:style-name="P10"><text:span text:style-name="T95">To run the unit test and view the results with </text:span><text:span text:style-name="T114">the </text:span><text:span text:style-name="T117">OpenCPI </text:span><text:span text:style-name="T114">GUI</text:span><text:span text:style-name="T115">:</text:span></text:p>
    <text:list xml:id="list150818627569500" text:continue-numbering="true" text:style-name="WWNum32">
     <text:list-item>
      <text:p text:style-name="P133"><text:span text:style-name="T91">In the </text:span>Project <text:span text:style-name="T112">Explorer</text:span>, <text:span text:style-name="T190">select </text:span><text:span text:style-name="Code"><text:span text:style-name="T96">time</text:span></text:span><text:span text:style-name="Code">_</text:span><text:span text:style-name="Code"><text:span text:style-name="T96">demux</text:span></text:span><text:span text:style-name="Code">.test</text:span><text:span text:style-name="T91">.</text:span></text:p>
     </text:list-item>
     <text:list-item>
      <text:p text:style-name="P133"><text:span text:style-name="T117">In Platforms, m</text:span><text:span text:style-name="T113">ake sure </text:span><text:span text:style-name="T121">RCC</text:span><text:span text:style-name="T113"> is checked and </text:span><text:span text:style-name="T121">centos7</text:span><text:span text:style-name="T113"> is highlighted.</text:span></text:p>
     </text:list-item>
     <text:list-item>
      <text:p text:style-name="P133"><text:span text:style-name="T116">Click </text:span><text:span text:style-name="T121">Run Unit Test</text:span><text:span text:style-name="T122">.</text:span></text:p>
     </text:list-item>
    </text:list>
