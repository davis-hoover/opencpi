   <text:h text:style-name="P90" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc31217_1709236796"/>Create New Project<text:bookmark-end text:name="__RefHeading___Toc31217_1709236796"/></text:h>
   <text:p text:style-name="P4"><text:span text:style-name="T52">As we did in Tutorials 3 and 4, we’ll create a new, clean project for Tutorial 5; we’ll call it </text:span><text:span text:style-name="Code">DemoProject</text:span><text:span text:style-name="Code"><text:span text:style-name="T47">5</text:span></text:span><text:span text:style-name="T53">. <text:s/>This project has the same requirements as the project we created for Tutorial 3 and 4.</text:span></text:p>
   <text:section text:style-name="Sect2" text:name="Section12" text:condition="ooow:AVGUI LEQ 1" text:display="condition">
    <text:p text:style-name="P29">To <text:span text:style-name="T104">create </text:span><text:span text:style-name="Code"><text:span text:style-name="T55">DemoProject</text:span></text:span><text:span text:style-name="Code"><text:span text:style-name="T56">5</text:span></text:span><text:span text:style-name="T14"> project using the OpenCPI GUI:</text:span></text:p>
    <text:list xml:id="list150818534834457" text:continue-numbering="true" text:style-name="WWNum32">
     <text:list-item>
      <text:p text:style-name="P105">Start <text:span text:style-name="T104">the OpenCPI GUI</text:span>.</text:p>
     </text:list-item>
     <text:list-item>
      <text:p text:style-name="P106"><text:span text:style-name="T201">From the GUI menu bar at the top of the window, select </text:span><text:span text:style-name="T32">Create</text:span><text:span text:style-name="T104"> &gt; </text:span><text:span text:style-name="T32">Project...</text:span></text:p>
     </text:list-item>
    </text:list>
    <text:p text:style-name="Diagram"><draw:frame draw:style-name="fr1" draw:name="Image1" text:anchor-type="as-char" svg:width="3.6701in" svg:height="3.5953in" draw:z-index="20"><draw:image>
