    <text:list xml:id="list150819169131422" text:continue-numbering="true" text:style-name="WWNum32">
     <text:list-item>
      <text:p text:style-name="List_20_Bullet">Click <text:span text:style-name="Strong_20_Emphasis">OK</text:span>. <text:s/>When the operation completes, you should see a <text:span text:style-name="T34">time_demux.comp</text:span> sub-directory in the <text:span text:style-name="Strong_20_Emphasis">components</text:span> directory displayed in the Project Explorer view.</text:p>
     </text:list-item>
     <text:list-item>
      <text:p text:style-name="P116">Use the Project Explorer or OpenCPI Projects panel to expand the <text:span text:style-name="T27">time_demux.comp/</text:span> directory. <text:s/>You should see the component spec you just created <text:span text:style-name="T27">time_demux-</text:span><text:span text:style-name="T38">comp</text:span><text:span text:style-name="T27">.xml</text:span>.</text:p>
     </text:list-item>
    </text:list>
