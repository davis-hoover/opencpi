    <text:list xml:id="list150818705787970" text:continue-numbering="true" text:style-name="WWNum32">
     <text:list-item>
      <text:p text:style-name="P107"><text:span text:style-name="T127">In </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T82">the New Project dialog</text:span></text:span><text:span text:style-name="T127">, enter</text:span> <text:span text:style-name="Strong_20_Emphasis">DemoProject</text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T47">5</text:span></text:span><text:span text:style-name="T47">. <text:s/>In </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T128">Project</text:span></text:span><text:span text:style-name="T128"> </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T128">Dependencies</text:span></text:span><text:span text:style-name="T128">, enter </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T128">ocpi.assets, ocpi.tutorial</text:span></text:span><text:span text:style-name="T128">.</text:span></text:p>
     </text:list-item>
     <text:list-item>
      <text:p text:style-name="P107"><text:span text:style-name="T128">Check </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T105">Register project</text:span></text:span>.</text:p>
     </text:list-item>
     <text:list-item>
      <text:p text:style-name="P108"><text:span text:style-name="T62">Leave all of the other fields as they are and c</text:span>lick <text:span text:style-name="T29">OK</text:span>. </text:p>
     </text:list-item>
     <text:list-item>
      <text:p text:style-name="P109">You should now see <text:span text:style-name="T175">DemoProject5</text:span> displayed in the OpenCPI Project Explorer panel. <text:s/>Like the other tutorials, subsequent sections show both ways to perform the steps described in the section: with the GUI and with the CLI. <text:s/>You can use either method; using both methods is redundant.</text:p>
     </text:list-item>
    </text:list>
