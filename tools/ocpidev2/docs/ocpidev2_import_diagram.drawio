        <mxCell id="vkVY_CGql35NdCOnT1ep-86" value="&lt;span style=&quot;border-color: var(--border-color);&quot;&gt;* HIGHER LAYERS DO NOT ACCESS LOWER LAYERS, e.g., a Worker never access its ComponentLibrary&lt;/span&gt;&lt;span style=&quot;border-color: var(--border-color);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;* ocpidev2.py handles ingest of the Command Line Interface (CLI) and creates a cli_dict variable for passing to the ProjectDatabase" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1770" y="40" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="vkVY_CGql35NdCOnT1ep-87" value="&lt;pre lang=&quot;python&quot; class=&quot;code highlight&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&quot;&quot;&quot;&lt;span class=&quot;s&quot;&gt; This file connects the CLI below with the verb (build/create/etc) interface&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;s&quot;&gt;    (ProjectDatabase class) interface of the Project above. It&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;s&quot;&gt;    interfaces with projects and not individual asset classes. &lt;/span&gt;&lt;span class=&quot;sh&quot;&gt;&quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;br/&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1679" y="695" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vkVY_CGql35NdCOnT1ep-88" value="&lt;pre lang=&quot;python&quot; class=&quot;code highlight&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&quot;&quot;&quot;&lt;span class=&quot;s&quot;&gt; This file exposes the Command Line Interface (CLI) below it, and above it&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;s&quot;&gt;    interfaces with project-like things (ProjectDatabase), and not individual&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;s&quot;&gt;    asset classes. &lt;/span&gt;&lt;span class=&quot;sh&quot;&gt;&quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;br/&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="1679" y="850" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vkVY_CGql35NdCOnT1ep-89" value="&lt;pre lang=&quot;python&quot; class=&quot;code highlight&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;&quot;&quot;&quot;&lt;span class=&quot;s&quot;&gt; This file connects the collection of projects below with all possible&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;s&quot;&gt;    project constituents (Component, ComponentLibrary, Worker, HdlAssembly,&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;s&quot;&gt;    HdlPlatform, etc) above. &lt;/span&gt;&lt;span class=&quot;sh&quot;&gt;&quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;br/&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
